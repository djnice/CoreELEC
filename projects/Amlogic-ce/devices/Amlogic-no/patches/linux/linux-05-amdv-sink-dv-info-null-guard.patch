From: djnice <djnice@freemail.hu>
Subject: amdolby_vision: guard sink dv_info access in FLAG_USE_SINK_MIN_MAX

When the TV drops HPD during Dolby Vision playback the current vout
switches to the invalid vinfo, whose vout_device is NULL. The next
vsync then dereferences vinfo->vout_device->dv_info in
amdv_parse_metadata_v2_stb() (and the same pattern exists in
amdv_parse_metadata_v1()), causing a NULL pointer dereference in
interrupt context and a kernel panic:

  [hdmitx:] HPD LOW / system: plugout
  Unable to handle kernel NULL pointer dereference at virtual address 0
  pc : amdv_parse_metadata_v2_stb+0x1a2c
  ... dv_toggle_frame -> amvideo_toggle_frame -> vsync_isr

Check vinfo, vout_device and dv_info before using the sink DV
capabilities, like the other dv_info users in amdv.c already do.
Without a sink the code falls through to the HDR/default luminance
handling.
---
--- a/common_drivers/drivers/media/enhancement/amdolby_vision/amdv.c
+++ b/common_drivers/drivers/media/enhancement/amdolby_vision/amdv.c
@@ -8897,7 +8897,10 @@
 	}
 
 	if (dolby_vision_flags & FLAG_USE_SINK_MIN_MAX) {
-		if (vinfo->vout_device->dv_info->ieeeoui == 0x00d046) {
+		/* vout_device is NULL on the invalid vinfo used after HPD loss */
+		if (vinfo && vinfo->vout_device &&
+		    vinfo->vout_device->dv_info &&
+		    vinfo->vout_device->dv_info->ieeeoui == 0x00d046) {
 			if (vinfo->vout_device->dv_info->ver == 0) {
 				/* need lookup PQ table ... */
 			} else if (vinfo->vout_device->dv_info->ver == 1) {
@@ -10448,7 +10451,10 @@
 	last_dst_format = dst_format;
 
 	if (dolby_vision_flags & FLAG_USE_SINK_MIN_MAX) {
-		if (vinfo->vout_device->dv_info->ieeeoui == 0x00d046) {
+		/* vout_device is NULL on the invalid vinfo used after HPD loss */
+		if (vinfo && vinfo->vout_device &&
+		    vinfo->vout_device->dv_info &&
+		    vinfo->vout_device->dv_info->ieeeoui == 0x00d046) {
 			if (vinfo->vout_device->dv_info->ver == 0) {
 				/* need lookup PQ table ... */
 			} else if (vinfo->vout_device->dv_info->ver == 1) {
